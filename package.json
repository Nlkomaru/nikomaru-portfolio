{
    "name": "nikomaru-portfolio-workspace",
    "private": true,
    "scripts": {
        "dev": "pnpm --filter @nikomaru-portfolio/app dev",
        "dev:tunnel": "pnpm --filter @nikomaru-portfolio/app dev:tunnel",
        "build": "pnpm --filter @nikomaru-portfolio/app build",
        "preview": "pnpm --filter @nikomaru-portfolio/app preview",
        "test": "pnpm --filter @nikomaru-portfolio/app test",
        "photos:sync": "node --env-file-if-exists=.env scripts/sync-photos.mjs",
        "test:photos": "node --test scripts/sync-photos.test.mjs",
        "prepare": "lefthook install",
        "check": "vp check",
        "deploy": "pnpm --filter @nikomaru-portfolio/app deploy",
        "deploy:app": "pnpm --filter @nikomaru-portfolio/app deploy",
        "deploy:storybook": "pnpm --filter ./storybook deploy",
        "cf-typegen": "pnpm --filter @nikomaru-portfolio/app cf-typegen",
        "storybook": "pnpm --filter ./storybook dev",
        "build-storybook": "pnpm --filter ./storybook build",
        "test:runner": "pnpm --filter ./storybook test:runner"
    },
    "devDependencies": {
        "@lhci/cli": "0.15.1",
        "blurhash": "^2.0.5",
        "lefthook": "^2.1.6",
        "sharp": "^0.35.5",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.5.1",
        "vite-plus": "1.5.1"
    },
    "packageManager": "pnpm@12.18.0"
}
