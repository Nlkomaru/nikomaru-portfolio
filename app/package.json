{
    "name": "@nikomaru-portfolio/app",
    "private": true,
    "type": "module",
    "scripts": {
        "prepare": "panda codegen",
        "dev": "vite dev --port 3000 --host --open",
        "dev:tunnel": "sh -c 'vite dev --port 3000 --host 0.0.0.0 & vite_pid=$!; trap \"kill $vite_pid 2>/dev/null\" EXIT INT TERM; cloudflared tunnel --url http://localhost:3000'",
        "build": "cf build",
        "panda:codegen": "panda codegen",
        "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
        "preview": "pnpm run build && vite preview",
        "test": "vitest run --config vitest.config.ts",
        "deploy": "pnpm run build && cf deploy --prebuilt",
        "cf-typegen": "cf workers types"
    },
    "dependencies": {
        "@chakra-ui/react": "^3.38.0",
        "@cloudflare/vite-plugin": "2.0.0-beta.v.12",
        "@emotion/react": "^11.14.0",
        "@fontsource/caveat": "^5.3.0",
        "@fontsource/jetbrains-mono": "^5.3.0",
        "@fontsource/noto-sans-jp": "^5.3.1",
        "@fontsource/poppins": "^5.3.0",
        "@fontsource/space-mono": "^5.3.0",
        "@inlang/paraglide-js": "^2.29.3",
        "@tanstack/react-devtools": "^0.7.0",
        "@tanstack/react-router": "^1.170.46",
        "@tanstack/react-router-devtools": "^1.167.4",
        "@tanstack/react-router-ssr-query": "^1.167.3",
        "@tanstack/react-start": "^1.169.7",
        "@tanstack/router-plugin": "^1.169.0",
        "@unpic/placeholder": "^0.1.2",
        "lucide-react": "^0.545.0",
        "motion": "^12.43.0",
        "next-themes": "^0.4.6",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "vite-tsconfig-paths": "^5.1.4",
        "yaml": "^2.9.1"
    },
    "devDependencies": {
        "@pandacss/dev": "^1.12.3",
        "@tanstack/devtools-vite": "^0.3.11",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^22.20.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^5.0.4",
        "autoprefixer": "^10.7.0",
        "cf": "1.0.0-beta.28",
        "jsdom": "^27.0.0",
        "typescript": "^5.7.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
        "vite-plus": "1.6.0",
        "vitest": "^3.2.7"
    }
}
