/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "nikomaru-portfolio",
    "compatibility_date": "2025-09-02",
    "compatibility_flags": ["nodejs_compat"],
    "main": "./worker.ts",
    "observability": {
        "enabled": true
    },
    "preview_urls": true,
    "routes": [
        {
            "pattern": "nikomaru.dev",
            "custom_domain": true
        },
        {
            "pattern": "www.nikomaru.dev",
            "custom_domain": true
        }
    ],
    "secrets_store_secrets": [
        {
            "binding": "CF_ACCESS_CLIENT_ID",
            "store_id": "d36d5a11ea07462c83bb21a0e9ccb811",
            "secret_name": "shared_CLOUDFLARE_ACCESS_CLIENT_ID"
        },
        {
            "binding": "CF_ACCESS_CLIENT_SECRET",
            "store_id": "d36d5a11ea07462c83bb21a0e9ccb811",
            "secret_name": "shared_CLOUDFLARE_ACCESS_CLIENT_SECRET"
        }
    ]
}
